# Copy to .env at the repository root. git ignores .env.
#
# On a Coder workspace, the platform's onboard command exports the bootcamp keys
# into your shell: OPENAI_API_KEY, OPENAI_BASE_URL, and the LANGFUSE_* keys.
# Leave them out of this file there. A value exported in the shell always wins
# over the same name here. See docs/setup.md.

# The Vector proxy key, on your own machine. The package reads OPENAI_API_KEY
# first and this name second.
#VECTOR_PROXY_API_KEY=<your_key>

# The proxy address. Unset means https://proxy.vectorinstitute.ai/v1.
#OPENAI_BASE_URL=

# Langfuse tracing. Nothing is traced unless both keys are set. Set the host
# only outside the default region.
#LANGFUSE_PUBLIC_KEY=
#LANGFUSE_SECRET_KEY=
#LANGFUSE_HOST=
